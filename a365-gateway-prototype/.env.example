# -----------------------------------------------------------------------------
# Gateway HTTP server
# -----------------------------------------------------------------------------

# Keep loopback for a local agent. A non-loopback value requires an API key.
OBS_GATEWAY_HOST=127.0.0.1
OBS_GATEWAY_PORT=4318
OBS_GATEWAY_MAX_REQUEST_BYTES=1048576

# Required by validation whenever OBS_GATEWAY_HOST is not loopback. Use the
# identical value as OBS_GATEWAY_API_KEY in the agent configuration.
OBS_GATEWAY_API_KEY=

# -----------------------------------------------------------------------------
# Microsoft Purview DLP
# -----------------------------------------------------------------------------

PURVIEW_DLP_ENABLED=true
PURVIEW_DLP_FAIL_CLOSED=true

# Leave empty to use AGENT365OBSERVABILITY__AGENTID, the Agent ID instance, as
# the Purview enterprise application policy location.
PURVIEW_APPLICATION_ID=
PURVIEW_APP_NAME=Agent 365 Observability Gateway
PURVIEW_APP_VERSION=1.0
PURVIEW_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
PURVIEW_TIMEOUT_SECONDS=15
PURVIEW_SCOPE_CACHE_SECONDS=3600

# -----------------------------------------------------------------------------
# Agent 365 observability
# -----------------------------------------------------------------------------

ENABLE_A365_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY_EXPORTER=true
A365_USE_S2S_ENDPOINT=true
A365_OBSERVABILITY_LOG_LEVEL=INFO

# Console spans can contain prompts and responses. Enable only for controlled
# local diagnostics.
A365_OBSERVABILITY_CONSOLE=false
MICROSOFT_OTEL_SDKSTATS_DISABLED=true

# -----------------------------------------------------------------------------
# Agent 365 generated registration settings
# -----------------------------------------------------------------------------
# Populate these values from the Agent 365 CLI registration output. Do not
# invent IDs, scopes, handler types, or credentials. Never commit real secrets.

CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__SCOPES=

# Agent 365 blueprint application ID stamped by the CLI. The gateway keeps this
# separate from the agent instance ID used for token exchange.
AGENT_ID=

AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__TYPE=
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__ALT_BLUEPRINT_NAME=
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__SCOPES=

CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION

# Agent ID application instance. This ID is used as the fmi_path/client ID for
# app-only Graph and Agent 365 token exchange and as the default Purview app ID.
AGENT365OBSERVABILITY__AGENTID=
AGENT365OBSERVABILITY__AGENTNAME=
AGENT365OBSERVABILITY__AGENTDESCRIPTION=
AGENT365OBSERVABILITY__TENANTID=
AGENT365OBSERVABILITY__AGENTBLUEPRINTID=

# Retained for compatibility with generated Agent 365 configuration. The
# gateway's service-to-service exporter uses the agentic token resolver.
AGENT365OBSERVABILITY__CLIENTID=
AGENT365OBSERVABILITY__CLIENTSECRET=